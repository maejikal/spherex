# Copy to backend/.env to override defaults. All variables use the SKY_ prefix.
# List values must be JSON.
SKY_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# SKY_SPHEREX_HIPS_URL=https://irsa.ipac.caltech.edu/data/hips/SPHEREx/spherex_allsky_cube
# SKY_SIMBAD_TAP_URLS=["https://simbad.cds.unistra.fr/simbad/sim-tap/sync","https://simbad.harvard.edu/simbad/sim-tap/sync"]
# SKY_CONNECT_TIMEOUT=5
# SKY_READ_TIMEOUT=20
# SKY_MAX_RETRIES=2
# SKY_SURVEY_CACHE_TTL_SECONDS=3600
# SKY_RESOLVER_CACHE_TTL_SECONDS=604800

# Blink viewer: the two local SPHEREx FITS exposures (fixed server-side paths, JSON list; ~ is expanded).
# SKY_BLINK_FITS_FILES=["~/Downloads/spherex_D5_2025_05_full.fits","~/Downloads/spherex_D5_2025_12_full.fits"]
# SKY_BLINK_PIXEL_SCALE_ARCSEC=6.15
# SKY_BLINK_DEFAULT_SIZE=256
